# Production mode rejects the public fictional example identities.
CAREER_MONITOR_MODE=production
CAREER_MONITOR_RESUME_FILE=./private/resume_facts.yaml
CAREER_MONITOR_CONFIG_DIR=./private/config
CAREER_MONITOR_DISCORD_SECRET_FILE=./private/secrets/discord-webhook

# The local runtime directory is outside the repository.
CAREER_MONITOR_DATA_DIR=/var/lib/career-monitor
CAREER_MONITOR_DISPLAY_LIMIT=25
CAREER_MONITOR_LOCK_TIMEOUT_SECONDS=0.25

# Optional OpenAI-compatible adjustment. Off mode makes no API request.
CAREER_MONITOR_LLM_MODE=off
CAREER_MONITOR_LLM_BASE_URL=
CAREER_MONITOR_LLM_MODEL=
# Compose mounts this host file at /run/secrets/llm-api-key.
CAREER_MONITOR_LLM_SECRET_FILE=/absolute/private/path/llm-api-key
CAREER_MONITOR_LLM_TIMEOUT_SECONDS=10
CAREER_MONITOR_LLM_RETRIES=0
CAREER_MONITOR_LLM_PROMPT_VERSION=v1
